---
import { formatDate, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">Nothing here yet. The first post is on its way.</p>
  ) : (
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <a href={`/writing/${post.id}/`}>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'short')}</time>
            <span class="title">
              {post.data.title}
              {post.data.draft && <span class="draft">Draft</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .posts li + li {
    border-top: 1px dashed var(--rule);
  }

  a {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.1rem;
    padding-block: 0.8rem;
    text-decoration: none;
  }

  @media (min-width: 540px) {
    a {
      grid-template-columns: 7.5rem 1fr;
      gap: 1rem;
      align-items: baseline;
    }
  }

  li:first-child a {
    padding-top: 0;
  }

  time {
    font-size: 0.875rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.35;
  }

  a:hover .title {
    color: var(--accent);
  }

  .draft {
    margin-left: 0.5rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: middle;
    color: var(--ink-3);
  }

  .empty {
    color: var(--ink-2);
  }
</style>
