---
import { SITE } from '../site';

const path = Astro.url.pathname;
const nav = [
  { label: 'About', href: '/#about' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Writing', href: '/writing/' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="name" href="/" aria-label={`${SITE.name}, home`}>
      <span class="mark" aria-hidden="true">tm</span>
      <span class="full">{SITE.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.href === '/writing/' && path.startsWith('/writing') ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid color-mix(in srgb, var(--rule) 70%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
  }

  .name {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .mark {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 7px;
    background: var(--ink);
    color: var(--paper);
    font-style: italic;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.04em;
    padding-bottom: 0.1em;
    transition: background-color 0.15s ease;
  }

  .name:hover {
    color: var(--ink);
  }

  .name:hover .mark {
    background: var(--accent);
  }

  ul {
    display: flex;
    gap: clamp(0.9rem, 3vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-size: 0.9375rem;
    color: var(--ink-2);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }

  @media (max-width: 540px) {
    .full {
      display: none;
    }
  }
</style>
