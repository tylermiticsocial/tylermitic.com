---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Base title="Writing" description="Notes, essays, and things worth remembering.">
  <header class="page-head">
    <h1>Writing</h1>
    <p class="muted">
      Notes, essays, and things worth remembering. Also available as an <a href="/rss.xml">RSS feed</a>.
    </p>
  </header>
  <PostList posts={posts} />
</Base>

<style>
  .page-head {
    margin-bottom: 3rem;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    font-weight: 380;
    letter-spacing: -0.03em;
  }

  .page-head p {
    margin-top: 0.9rem;
    max-width: 34rem;
  }
</style>
