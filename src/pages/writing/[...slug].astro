---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, draft } = post.data;
---

<Base title={title} description={description} type="article">
  <article>
    <header class="post-head">
      <p class="meta">
        <a href="/writing/">Writing</a>
        <span aria-hidden="true">/</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {draft && <span class="draft">Draft</span>}
      </p>
      <h1>{title}</h1>
      {description && <p class="dek">{description}</p>}
    </header>
    <div class="prose">
      <Content />
    </div>
    {
      updated && (
        <p class="updated">
          Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
        </p>
      )
    }
  </article>
  <p class="back"><a href="/writing/">← All writing</a></p>
</Base>

<style>
  article {
    max-width: 40rem;
  }

  .post-head {
    margin-bottom: 2.75rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .meta a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .meta a:hover {
    color: var(--accent);
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .dek {
    margin-top: 1rem;
    font-size: 1.2rem;
    color: var(--ink-2);
  }

  .draft {
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .updated {
    margin-top: 3rem;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .back {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
  }

  .back a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--accent);
  }
</style>
